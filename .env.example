# ===== حَكَم — متغيرات البيئة =====
# أبسط إعداد: مفتاح OpenAI فقط. بقية المزودين تُضاف من صفحة الإعدادات (/settings)
OPENAI_API_KEY=sk-your-key-here

# أي مزود متوافق مع OpenAI بدل OpenAI الرسمي (OpenRouter، Gemini، DeepSeek، Ollama…)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# مفاتيح إضافية يمكن الإشارة إليها في صفحة الإعدادات بكتابة env:اسم_المتغير
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# نماذج الوكلاء الافتراضية (تُتجاهل إذا حُفظت إعدادات من الواجهة)
# HAKAM_MODEL_ANALYZER=gpt-5.2
# HAKAM_MODEL_HYPOTHESIS=o4-mini
# HAKAM_MODEL_VERIFIER=gpt-5-mini
# HAKAM_MODEL_SYNTHESIZER=gpt-5.2
# HAKAM_VERIFICATION_THRESHOLD=0.7

# ===== الويب (الاستضافة) =====
# رمز المسؤول لفتح صفحة الإعدادات على الويب. بدونه تبقى الإعدادات للقراءة فقط.
# HAKAM_ADMIN_TOKEN=غيّر-هذا-إلى-رمز-طويل-عشوائي
# رمز اختياري يحمي الموقع كله (صفحة دخول)
# HAKAM_ACCESS_TOKEN=
# بديل كامل لصفحة الإعدادات: الإعدادات كلها كـ JSON (انظر docs/DEPLOYMENT.md)
# HAKAM_SETTINGS_JSON=

# ===== عام =====
# HAKAM_DATA_DIR=data            # مكان قاعدة البيانات وproviders.json
# HAKAM_API_TIMEOUT=120
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=0
